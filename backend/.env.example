# Copie este archivo como .env y ajuste los valores. NO suba .env al repositorio.

# Base PostgreSQL. Con `npm run db:local` use exactamente esta URL.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/tutorapp"

# Secreto para firmar los tokens de sesión. Cambie el valor (mínimo 32 caracteres).
JWT_SECRET="cambie-este-secreto-por-uno-largo-y-aleatorio-123456"
# Duración de la sesión en minutos.
JWT_EXPIRA_MINUTOS=30

# Puerto de la API y origen permitido del frontend (CORS).
PORT=3001
FRONTEND_ORIGIN="http://localhost:3000"

# Si es "true" se permite registrar y agendar horarios que ya pasaron.
# Sirve para demostraciones y pruebas E2E. En producción debe ser "false".
PERMITIR_HORARIOS_PASADOS=false

# Archivo opcional donde se guardan los logs en formato JSON (uno por línea).
LOG_FILE="logs/tutorapp.log"
